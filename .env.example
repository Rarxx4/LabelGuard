# Copy this file to .env and fill in ONE of the keys.

# Option A (default, free tier): Google Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B: Anthropic Claude - https://platform.claude.com (paid credits)
# ANTHROPIC_API_KEY=sk-ant-...
# LABELGUARD_PROVIDER=claude

# Optional overrides
# LABELGUARD_GEMINI_MODEL=gemini-3.8-flash     # or gemini-flash-latest
# LABELGUARD_CLAUDE_MODEL=claude-opus-5-5
# LABELGUARD_CACHE=1                            # cache AI responses (instant re-runs while recording a demo)
